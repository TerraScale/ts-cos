package cos

// budgetSection is the Token budgets panel on Settings: editable base limits and today's meters.
templ budgetSection(d budgetPanelData) {
	<section id="budgets" class="panel" aria-labelledby="budgets-heading">
		<header class="panel-head"><h2 id="budgets-heading">Token budgets</h2></header>
		if d.Alert != "" {
			<p role="alert" class="alert" data-tone={ d.Tone }>{ d.Alert }</p>
		}
		<div class="stack">
			<p class="meta">Input + cache writes + output per UTC day; cache reads are not counted.</p>
			<form class="stack" method="post" action="/settings/budgets">
				<div class="field">
					<label class="field-label" for="budget-thread">Per thread, per day</label>
					<input id="budget-thread" name="thread" type="text" inputmode="numeric" required value={ d.Thread } aria-describedby="budget-thread-hint"/>
					<span id="budget-thread-hint" class="field-hint">Default 10M · e.g. 15M or 500k</span>
				</div>
				<div class="field">
					<label class="field-label" for="budget-daily">All threads, per day</label>
					<input id="budget-daily" name="daily" type="text" inputmode="numeric" required value={ d.Daily } aria-describedby="budget-daily-hint"/>
					<span id="budget-daily-hint" class="field-hint">Default 100M · e.g. 15M or 500k</span>
				</div>
				<div class="row">
					<button class="btn-primary" type="submit">Save</button>
				</div>
			</form>
			<div class="stack" aria-label="Today's usage against limits">
				<p class="meta">Today, UTC</p>
				for _, m := range d.Meters {
					<div class="meter-row">
						<span class="meter-label">
							{ m.Label }
							if m.Raised {
								<span class="tag">raised today</span>
							}
							if m.NeverPaused {
								<span class="tag">never paused</span>
							}
						</span>
						<meter class="meter" min="0" max={ m.Max } low={ m.Low } high={ m.Max } optimum="0" value={ m.Value }></meter>
						<span class="meter-value">{ m.Text }</span>
					</div>
				}
			</div>
		</div>
	</section>
}
