package cos

// adminTopbar is the top bar of the admin pages, with Admin marked as the current section.
templ adminTopbar() {
	<header class="topbar">
		<a class="brand" href="/"><span class="brand-mark" aria-hidden="true">C</span>COS</a>
		<nav class="topbar-nav" aria-label="Main">
			<a class="navlink" href="/">Chat</a>
			<a class="navlink" href="/nodes">Nodes</a>
			<a class="navlink" href="/settings">Settings</a>
			<a class="navlink" href="/admin" aria-current="page">Admin</a>
		</nav>
	</header>
}

// adminPage is the user list: the invite form, the one-time link, and each account's actions.
templ adminPage(v adminView) {
	<!DOCTYPE html>
	<html lang="en">
		@docHead("Users · COS")
		<body class="shell">
			@adminTopbar()
			<main class="page page-narrow">
				<section class="panel" aria-labelledby="users-heading">
					<header class="panel-head"><h1 id="users-heading">Users</h1></header>
					if v.Notice != "" {
						<p class="alert" role="status" data-tone={ v.Tone }>{ v.Notice }</p>
					}
					if v.Invite != "" {
						<label class="field">
							<span class="field-label">Invite link for { v.Name }</span>
							<input class="mono" readonly value={ v.Invite } onfocus="this.select()"/>
						</label>
					}
					<form method="post" action="/admin/invite" class="stack">
						<label class="field">
							<span class="field-label">Invite a user</span>
							<input name="name" required maxlength="64" pattern="[a-z0-9_-]{1,64}" autocomplete="off" placeholder="login name"/>
							<span class="field-hint">Lowercase letters, digits, _ or -.</span>
						</label>
						<button type="submit" class="btn-primary">Create invite</button>
					</form>
					<div class="table-wrap">
						<table class="table">
							<thead>
								<tr><th>Login name</th><th>Role</th><th>Created</th><th>State</th><th><span class="sr-only">Actions</span></th></tr>
							</thead>
							<tbody>
								for _, row := range v.Rows {
									<tr>
										<th scope="row">
											{ row.User.Name }
											if row.User.ID == v.Me {
												<span class="muted">(you)</span>
											}
										</th>
										<td>{ row.User.Role }</td>
										<td>@when(row.Created)</td>
										<td>
											{ row.State() }
											if !row.Disabled.IsZero() {
												<span class="muted">since</span> @when(row.Disabled)
											}
										</td>
										<td>
											if row.Pending {
												<form method="post" action={ templ.SafeURL("/admin/users/" + row.User.ID + "/invite") } class="inline-form">
													<button type="submit" class="btn btn-ghost">Invite again</button>
												</form>
											}
											if row.User.ID != v.Me {
												if row.Disabled.IsZero() {
													<form method="post" action={ templ.SafeURL("/admin/users/" + row.User.ID + "/disable") } class="inline-form">
														<button type="submit" class="btn btn-ghost">Disable</button>
													</form>
												} else {
													<form method="post" action={ templ.SafeURL("/admin/users/" + row.User.ID + "/enable") } class="inline-form">
														<button type="submit" class="btn btn-ghost">Enable</button>
													</form>
												}
												<a class="btn btn-ghost btn-danger" href={ templ.SafeURL("/admin/users/" + row.User.ID + "/delete") }>Delete</a>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</section>
			</main>
		</body>
	</html>
}

// deletePage asks for the login name, after listing what the delete removes.
templ deletePage(v deleteView) {
	<!DOCTYPE html>
	<html lang="en">
		@docHead("Delete " + v.Row.User.Name + " · COS")
		<body class="shell">
			@adminTopbar()
			<main class="page page-narrow">
				<section class="panel" aria-labelledby="delete-heading">
					<header class="panel-head"><h1 id="delete-heading">Delete { v.Row.User.Name }</h1></header>
					if v.Notice != "" {
						<p class="alert" role="alert" data-tone="danger">{ v.Notice }</p>
					}
					<p>This removes the login, every session and every COS record of this user. It cannot be undone.</p>
					<ul>
						if v.Host != "" {
							<li>The COS thread on { v.Host } closes first.</li>
						}
						for _, b := range v.Data {
							<li>{ b.Bucket }: { integer(b.Keys) } keys</li>
						}
					</ul>
					<form method="post" action={ templ.SafeURL("/admin/users/" + v.Row.User.ID + "/delete") } class="stack">
						<label class="field">
							<span class="field-label">Type { v.Row.User.Name } to confirm</span>
							<input name="confirm" required autocomplete="off"/>
						</label>
						<button type="submit" class="btn btn-danger">Delete user</button>
					</form>
					<p class="auth-foot"><a href="/admin">Back to users</a></p>
				</section>
			</main>
		</body>
	</html>
}
