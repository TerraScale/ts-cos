package cos

// The chat page is the chat with the Inbox, Nodes and Work beside it; the KPI tiles sit above the log.
templ chatPage(h chatHeader, k kpiView, v Dashboard, entries []ChatEntry, b workBoard, ok bool, nodes []NodeCard, nodesOK bool) {
	<!DOCTYPE html>
	<html lang="en">
		@docHead("COS · TerraScale")
		<body class="ts-app cos-chat" data-init="@get('/chat/events', {retry: 'always', retryMaxCount: Infinity, retryMaxWait: 10000})" data-signals="{tab: location.hash.startsWith('#inbox') ? 'inbox' : 'chat'}" data-attr:data-tab="$tab">
			@releaseWatch()
			@chatHead(h, "chat")
			<div class="cos-chat-body">
				<main id="main" class="cos-chat-main">
					@kpiTiles(k)
					<div id="scroll" class="chat-log" data-signals="{stick:true,chatTick:0}" data-on:scroll="$stick = el.scrollHeight - el.scrollTop - el.clientHeight < 80" data-effect="$chatTick; $stick && (el.scrollTop = el.scrollHeight)">
						@chatMessages(entries)
					</div>
					<form id="composer" class="composer" data-on:submit__prevent="@post('/chat')">
						<textarea data-bind:msg rows="2" maxlength="20000" placeholder="Message COS" aria-label="Message COS" data-on:keydown="evt.key === 'Enter' && (evt.ctrlKey || evt.metaKey) && el.form.requestSubmit()"></textarea>
						<button class="btn-primary" type="submit">Send</button>
					</form>
					<p id="chat-notice" class="toast" role="status"></p>
				</main>
				<aside class="cos-inbox-col" aria-label="Inbox, nodes and work">
					<section id="pane-inbox" class="pane">@inbox(v)</section>
					@nodesSummary(nodes, nodesOK)
					@workPane(b, ok)
				</aside>
			</div>
		</body>
	</html>
}

// skeletonPane holds a slot beside the chat until its feature lands.
templ skeletonPane(id, title, note string) {
	<section id={ id } class="pane panel">
		<header class="panel-head"><h2>{ title }</h2></header>
		<p class="meta">{ note }</p>
		<span class="skeleton-bar"></span>
		<span class="skeleton-bar"></span>
		<span class="skeleton-bar"></span>
	</section>
}

// workPane is the home's Work slot: the summary once the board reads, the skeleton if it does not.
templ workPane(b workBoard, ok bool) {
	if ok {
		@workSummary(b)
	} else {
		@skeletonPane("pane-work", "Work", "Work board unavailable")
	}
}

// nodesSummary is the home's Nodes slot: one line per host beside the chat; the full cards stay on /nodes.
templ nodesSummary(cards []NodeCard, ok bool) {
	if ok {
		<section id="pane-nodes" class="pane panel" aria-labelledby="pane-nodes-heading">
			<header class="panel-head"><h2 id="pane-nodes-heading">Nodes</h2></header>
			if len(cards) == 0 {
				<p class="empty">No nodes have reported yet.</p>
			} else {
				<ul class="list">
					for _, c := range cards {
						<li><a href={ "/nodes#" + c.Host }><span class="dot" data-state={ c.State }></span> { c.Host }</a> <span class="muted">CPU { c.text(formatFixed(c.Sample.CPU, 0)) }{ c.unit("%") } · Mem { c.text(formatFixed(c.Sample.Mem.UsedPercent(), 0)) }{ c.unit("%") }</span></li>
					}
				</ul>
			}
			<a class="btn" href="/nodes">Open nodes</a>
		</section>
	} else {
		@skeletonPane("pane-nodes", "Nodes", "Nodes unavailable")
	}
}

// workSummary shows the stage counts beside the chat; the full table stays on /work.
templ workSummary(b workBoard) {
	<section id="pane-work" class="pane panel" aria-labelledby="pane-work-heading">
		<header class="panel-head"><h2 id="pane-work-heading">Work <span class="badge badge-accent">{ integer(b.Total) }</span></h2></header>
		if b.Total == 0 {
			<p class="empty">No work yet.</p>
		} else {
			<ul class="list">
				for _, group := range b.Filters {
					for _, f := range group {
						if f.Value != "" {
							<li><a href={ "/work" + workQuery(f.Value) }>{ f.Label }</a> <span class="badge">{ integer(f.Count) }</span></li>
						}
					}
				}
			</ul>
		}
		<a class="btn" href="/work">Open work board</a>
	</section>
}

templ kpiTiles(k kpiView) {
	<section id="kpis" class="kpis" aria-label="Today" data-probe={ k.K.Probe }>
		<div class="kpi">
			<span class="kpi-label">Threads running</span>
			<strong class="kpi-value">{ integer(k.Running) }</strong>
			<span class="kpi-delta">across hosts</span>
		</div>
		<div class="kpi">
			<span class="kpi-label">PRs waiting</span>
			<strong class="kpi-value">{ integer(k.PRs) }</strong>
			<span class="kpi-delta">open PRs</span>
		</div>
		<div class="kpi">
			<span class="kpi-label">Merges today</span>
			<strong class="kpi-value">{ integer(k.K.Merges) }</strong>
			<span class="kpi-delta">since 00:00 UTC</span>
		</div>
		<div class="kpi" data-tone={ e2eTone(k.K) }>
			<span class="kpi-label">E2E pass / fail / skip</span>
			<strong class="kpi-value">{ e2eValue(k.K) }</strong>
			<span class="kpi-delta">{ e2eSub(k.K) }</span>
		</div>
		<div class="kpi">
			<span class="kpi-label"><a href="/tokens">Tokens + cost today</a></span>
			<strong class="kpi-value">{ tokensValue(k.K) }</strong>
			<span class="kpi-delta">{ tokensSub(k.K) }</span>
		</div>
		<div class="kpi" data-tone={ heartbeatTone(k.Autopilot) }>
			<span class="kpi-label"><a href="/settings">Heartbeat</a></span>
			<strong class="kpi-value">{ heartbeatValue(k.Autopilot) }</strong>
			<span class="kpi-delta">{ heartbeatSub(k.Autopilot) }</span>
		</div>
	</section>
}

templ settingsPage(h chatHeader, a AutopilotState, b budgetPanelData, push PushState) {
	<!DOCTYPE html>
	<html lang="en">
		@docHead("Settings · COS")
		<body class="ts-app">
			@chatHead(h, "settings")
			<main class="page page-narrow">
				@autopilotPanel(a)
				@pushPanel(push)
				@budgetSection(b)
				<section class="panel" aria-labelledby="account-heading">
					<header class="panel-head"><h2 id="account-heading">Account</h2></header>
					<div class="row">
						<a class="btn" href="/password">Change password</a>
						<form class="inline-form" method="post" action="/logout">
							<button type="submit">Log out</button>
						</form>
					</div>
				</section>
			</main>
			<p id="autopilot-notice" class="toast" role="status"></p>
		</body>
	</html>
}

// chatHead is the one top bar on every page; page marks the current link. On the chat page phones get an
// Inbox toggle instead of the link, because the Inbox column sits beside the chat there.
templ chatHead(h chatHeader, page string) {
	<header id="chat-head" class="ts-topbar">
		<a class="ts-topbar-brand" href="/"><img src="/static/icon.svg" alt="" width="24" height="24"/><span>COS</span></a>
		<ul id="topbar-stats" class="ts-topbar-stats" aria-label="Status">
			<!-- TS-813 heartbeat state -->
			<li id="heartbeat-slot" class="ts-topbar-stat">
				if h.Autopilot.Interval > 0 {
					<a href="/settings">
						Heartbeat { integer(h.Autopilot.Interval) } min ·
						if next := h.Autopilot.NextBeatTime(); next.IsZero() {
							after the leader's first check
						} else {
							next @when(next)
						}
					</a>
				}
			</li>
			<li class="ts-topbar-stat">{ integer(h.Running) } running</li>
			<li class="ts-topbar-stat">{ integer(h.PRs) } PRs waiting</li>
		</ul>
		<nav class="ts-topnav" aria-label="Main">
			for _, l := range navLinks {
				<a class="ts-nav-link" href={ templ.SafeURL(l.href) } { currentPage(page, l.page)... }>{ l.label }</a>
			}
		</nav>
		<a id="inbox-slot" class="ts-nav-link ts-topbar-inbox" href="/inbox" { currentPage(page, "inbox")... }>Inbox <span class="ts-nav-count">{ integer(h.Inbox) }</span></a>
		if page == "chat" {
			<button type="button" class="ts-nav-link ts-topbar-inbox-toggle" data-on:click="$tab = $tab == 'inbox' ? 'chat' : 'inbox'" data-attr:aria-pressed="$tab == 'inbox'">Inbox <span class="ts-nav-count">{ integer(h.Inbox) }</span></button>
		}
	</header>
}

templ chatMessages(entries []ChatEntry) {
	<div id="messages" class="chat-thread" role="log" aria-live="polite">
		if len(entries) == 0 {
			<p class="msg system" id="m-empty">Ask COS anything: what's running, what needs you, or what to do next.</p>
		}
		for _, e := range entries {
			@chatEntry(e)
		}
	</div>
}

templ chatEntry(e ChatEntry) {
	<article id={ "m-" + e.ID } class={ "msg", e.Role }>
		switch e.Role {
			case "user":
				{ e.Text }
			case "system":
				<small>{ e.Text }</small>
			default:
				if len(e.Tools) > 0 {
					<details class="disclosure msg-tools">
						<summary>{ toolSummary(e.Tools) }</summary>
						<ol>
							for _, tool := range e.Tools {
								<li>{ tool }</li>
							}
						</ol>
					</details>
				}
				<div class="prose">@templ.Raw(renderMarkdown(e.Text))</div>
				if e.Ask != nil {
					for _, q := range e.Ask.Questions {
						<p><strong>{ q.Header }</strong><br/>{ q.Text }</p>
						if answer, ok := e.Ask.Answers[q.ID]; ok {
							<p><mark>{ answer }</mark></p>
						} else if e.Ask.Done {
							<p><small>Answered elsewhere.</small></p>
						} else {
							<p class="options">
								for i, option := range q.Options {
									<button type="button" class="outline" data-on:click={ answerAction(e.ID, q.ID, i) }>{ option }</button>
								}
							</p>
						}
					}
				}
				if e.Streaming {
					<small class="msg-status" aria-busy="true">Working…</small>
				}
		}
	</article>
}
