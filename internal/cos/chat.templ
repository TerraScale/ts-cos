package cos

templ chatPage(h chatHeader, entries []ChatEntry) {
	<!DOCTYPE html>
	<html lang="en">
		@docHead("COS · TerraScale")
		<body class="shell chat" data-init="@get('/chat/events', {retry: 'always', retryMaxCount: Infinity, retryMaxWait: 10000})">
			@releaseWatch()
			@chatHead(h)
			<main id="scroll" class="chat-log">
				@chatMessages(entries)
			</main>
			<form id="composer" class="composer" data-on:submit__prevent="@post('/chat')">
				<textarea data-bind:msg rows="2" maxlength="20000" placeholder="Message COS" aria-label="Message COS" data-on:keydown="evt.key === 'Enter' && (evt.ctrlKey || evt.metaKey) && el.form.requestSubmit()"></textarea>
				<button class="btn-primary" type="submit">Send</button>
			</form>
		</body>
	</html>
}

templ settingsPage(a AutopilotState) {
	<!DOCTYPE html>
	<html lang="en">
		@docHead("Settings · COS")
		<body class="shell">
			<header class="topbar">
				<a class="brand" href="/"><span class="brand-mark" aria-hidden="true">C</span>COS</a>
				<nav class="topbar-nav" aria-label="Main">
					<a class="navlink" href="/">Chat</a>
					<a class="navlink" href="/settings" aria-current="page">Settings</a>
				</nav>
			</header>
			<main class="page page-narrow">
				@autopilotPanel(a)
				<section class="panel" aria-labelledby="account-heading">
					<header class="panel-head"><h2 id="account-heading">Account</h2></header>
					<div class="row">
						<a class="btn" href="/password">Change password</a>
						<form class="inline-form" method="post" action="/logout">
							<button type="submit">Log out</button>
						</form>
					</div>
				</section>
			</main>
			<p id="autopilot-notice" class="toast" role="status"></p>
		</body>
	</html>
}

templ chatHead(h chatHeader) {
	<header id="chat-head" class="topbar">
		<a class="brand" href="/"><span class="brand-mark" aria-hidden="true">C</span>COS</a>
		<ul class="topbar-stats" aria-label="Status">
			<!-- TS-813 heartbeat state -->
			<li id="heartbeat-slot" class="stat">
				if h.Autopilot.Interval > 0 {
					<a href="/settings">Heartbeat { integer(h.Autopilot.Interval) } min · next { h.Autopilot.NextBeat() }</a>
				}
			</li>
			<li class="stat">{ integer(h.Running) } running</li>
			<li class="stat">{ integer(h.PRs) } PRs waiting</li>
		</ul>
		<nav class="topbar-nav" aria-label="Main">
			<a class="navlink" href="/">Chat</a>
			<a class="navlink hide-sm" href="/work">Work</a>
			<a id="inbox-slot" class="navlink" href="/inbox">Inbox <span class="badge badge-accent">{ integer(h.Inbox) }</span></a>
			<a class="navlink hide-sm" href="/tokens">Tokens</a>
			<a class="navlink" href="/settings">Settings</a>
		</nav>
	</header>
}

templ chatMessages(entries []ChatEntry) {
	<div id="messages" class="chat-thread" role="log" aria-live="polite">
		if len(entries) == 0 {
			<p class="msg system" id="m-empty">Ask COS anything: what's running, what needs you, or what to do next.</p>
		}
		for _, e := range entries {
			@chatEntry(e)
		}
	</div>
}

templ chatEntry(e ChatEntry) {
	<article id={ "m-" + e.ID } class={ "msg", e.Role }>
		switch e.Role {
			case "user":
				{ e.Text }
			case "system":
				<small>{ e.Text }</small>
			default:
				if len(e.Tools) > 0 {
					<details class="disclosure msg-tools">
						<summary>{ toolSummary(e.Tools) }</summary>
						<ol>
							for _, tool := range e.Tools {
								<li>{ tool }</li>
							}
						</ol>
					</details>
				}
				<div class="prose">@templ.Raw(renderMarkdown(e.Text))</div>
				if e.Streaming {
					<small class="msg-status" aria-busy="true">Working…</small>
				}
		}
	</article>
}
