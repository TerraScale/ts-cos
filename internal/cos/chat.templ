package cos

// The home is the app shell: Chat in the center, Inbox, Nodes and Work beside it. Phones pick one pane with the tab bar.
templ chatPage(h chatHeader, k kpiView, v Dashboard, entries []ChatEntry, b workBoard, ok bool) {
	<!DOCTYPE html>
	<html lang="en">
		@docHead("COS · TerraScale")
		<body class="app chat" data-init="@get('/chat/events', {retry: 'always', retryMaxCount: Infinity, retryMaxWait: 10000})" data-signals="{tab:'chat'}" data-attr:data-tab="$tab">
			@releaseWatch()
			@chatHead(h)
			<div class="app-body">
				<nav class="sidebar" aria-label="Sections">
					<p class="side-title">COS</p>
					<a class="side-link" href="#pane-chat" title="Chat" data-on:click__prevent="$tab='chat'" data-attr:aria-current="$tab=='chat' ? 'page' : false">@icon("chat")<span>Chat</span></a>
					<a class="side-link" href="#pane-inbox" title="Inbox" data-on:click__prevent="$tab='inbox'" data-attr:aria-current="$tab=='inbox' ? 'page' : false">@icon("inbox")<span>Inbox</span> @countBadge("side-inbox", "badge", h.Inbox)</a>
					<a class="side-link" href="#pane-nodes" title="Nodes" data-on:click__prevent="$tab='nodes'" data-attr:aria-current="$tab=='nodes' ? 'page' : false">@icon("nodes")<span>Nodes</span></a>
					<a class="side-link" href="#pane-work" title="Work" data-on:click__prevent="$tab='work'" data-attr:aria-current="$tab=='work' ? 'page' : false">@icon("work")<span>Work</span></a>
					<a class="side-link" href="/settings" title="Settings">@icon("settings")<span>Settings</span></a>
				</nav>
				<main class="app-main" id="pane-chat">
					@kpiTiles(k)
					<div id="scroll" class="chat-log">
						@chatMessages(entries)
					</div>
					<form id="composer" class="composer" data-on:submit__prevent="@post('/chat')">
						<textarea data-bind:msg rows="2" maxlength="20000" placeholder="Message COS" aria-label="Message COS" data-on:keydown="evt.key === 'Enter' && (evt.ctrlKey || evt.metaKey) && el.form.requestSubmit()"></textarea>
						<button class="btn-primary" type="submit">Send</button>
					</form>
				</main>
				<aside class="app-aside" aria-label="Inbox, nodes and work">
					<section id="pane-inbox" class="pane">@inbox(v)</section>
					@skeletonPane("pane-nodes", "Nodes", "Nodes panel lands with TS-825")
					@workPane(b, ok)
				</aside>
			</div>
			<nav class="tabbar" aria-label="Sections">
				<a class="tab" href="#pane-chat" data-on:click__prevent="$tab='chat'" data-attr:aria-current="$tab=='chat' ? 'page' : false">@icon("chat")<span>Chat</span></a>
				<a class="tab" href="#pane-inbox" data-on:click__prevent="$tab='inbox'" data-attr:aria-current="$tab=='inbox' ? 'page' : false">@icon("inbox")<span>Inbox</span> @countBadge("tab-inbox", "tab-badge", h.Inbox)</a>
				<a class="tab" href="#pane-nodes" data-on:click__prevent="$tab='nodes'" data-attr:aria-current="$tab=='nodes' ? 'page' : false">@icon("nodes")<span>Nodes</span></a>
				<a class="tab" href="#pane-work" data-on:click__prevent="$tab='work'" data-attr:aria-current="$tab=='work' ? 'page' : false">@icon("work")<span>Work</span></a>
			</nav>
		</body>
	</html>
}

// countBadge keeps its id while the count changes, so each patch replaces it in place.
templ countBadge(id, class string, n int) {
	<span id={ id }>
		if n > 0 {
			<span class={ class }>{ integer(n) }</span>
		}
	</span>
}

// icon draws the rail and tab-bar glyphs with plain strokes; cos.css sizes and colors them.
templ icon(name string) {
	<svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
		switch name {
			case "chat":
				<path d="M4 5h16v11H9l-5 4z"/>
			case "inbox":
				<path d="M3 13l2.5-7h13L21 13v6H3z"/><path d="M3 13h5l1 2h6l1-2h5"/>
			case "nodes":
				<rect x="4" y="3" width="16" height="7" rx="1"/><rect x="4" y="14" width="16" height="7" rx="1"/><path d="M7 6.5h2M7 17.5h2"/>
			case "work":
				<rect x="3" y="4" width="5" height="16" rx="1"/><rect x="10" y="4" width="5" height="10" rx="1"/><rect x="17" y="4" width="4" height="13" rx="1"/>
			case "settings":
				<path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/>
		}
	</svg>
}

// skeletonPane holds a sidebar slot until its feature lands.
templ skeletonPane(id, title, note string) {
	<section id={ id } class="pane panel">
		<header class="panel-head"><h2>{ title }</h2></header>
		<p class="meta">{ note }</p>
		<span class="skeleton-bar"></span>
		<span class="skeleton-bar"></span>
		<span class="skeleton-bar"></span>
	</section>
}

// workPane is the home's Work slot: the summary once the board reads, the skeleton if it does not.
templ workPane(b workBoard, ok bool) {
	if ok {
		@workSummary(b)
	} else {
		@skeletonPane("pane-work", "Work", "Work board unavailable")
	}
}

// workSummary shows the stage counts beside the chat; the full table stays on /work.
templ workSummary(b workBoard) {
	<section id="pane-work" class="pane panel" aria-labelledby="pane-work-heading">
		<header class="panel-head"><h2 id="pane-work-heading">Work <span class="badge badge-accent">{ integer(b.Total) }</span></h2></header>
		if b.Total == 0 {
			<p class="empty">No work yet.</p>
		} else {
			<ul class="list">
				for _, group := range b.Filters {
					for _, f := range group {
						if f.Value != "" {
							<li><a href={ "/work" + workQuery(f.Value) }>{ f.Label }</a> <span class="badge">{ integer(f.Count) }</span></li>
						}
					}
				}
			</ul>
		}
		<a class="btn" href="/work">Open work board</a>
	</section>
}

templ kpiTiles(k kpiView) {
	<section id="kpis" class="kpis" aria-label="Today" data-probe={ k.K.Probe }>
		<div class="kpi">
			<span class="kpi-label">Threads running</span>
			<strong class="kpi-value">{ integer(k.Running) }</strong>
			<span class="kpi-delta">across hosts</span>
		</div>
		<div class="kpi">
			<span class="kpi-label">PRs waiting</span>
			<strong class="kpi-value">{ integer(k.PRs) }</strong>
			<span class="kpi-delta">open PRs</span>
		</div>
		<div class="kpi">
			<span class="kpi-label">Merges today</span>
			<strong class="kpi-value">{ integer(k.K.Merges) }</strong>
			<span class="kpi-delta">since 00:00 UTC</span>
		</div>
		<div class="kpi" data-tone={ e2eTone(k.K) }>
			<span class="kpi-label">E2E pass / fail / skip</span>
			<strong class="kpi-value">{ e2eValue(k.K) }</strong>
			<span class="kpi-delta">{ e2eSub(k.K) }</span>
		</div>
		<div class="kpi">
			<span class="kpi-label"><a href="/tokens">Tokens + cost today</a></span>
			<strong class="kpi-value">{ tokensValue(k.K) }</strong>
			<span class="kpi-delta">{ tokensSub(k.K) }</span>
		</div>
		<div class="kpi" data-tone={ heartbeatTone(k.Autopilot) }>
			<span class="kpi-label"><a href="/settings">Heartbeat</a></span>
			<strong class="kpi-value">{ heartbeatValue(k.Autopilot) }</strong>
			<span class="kpi-delta">{ heartbeatSub(k.Autopilot) }</span>
		</div>
	</section>
}

templ settingsPage(a AutopilotState, b budgetPanelData) {
	<!DOCTYPE html>
	<html lang="en">
		@docHead("Settings · COS")
		<body class="shell">
			<header class="topbar">
				<a class="brand" href="/"><span class="brand-mark" aria-hidden="true">C</span>COS</a>
				<nav class="topbar-nav" aria-label="Main">
					<a class="navlink" href="/">Chat</a>
					<a class="navlink" href="/settings" aria-current="page">Settings</a>
				</nav>
			</header>
			<main class="page page-narrow">
				@autopilotPanel(a)
				@budgetSection(b)
				<section class="panel" aria-labelledby="account-heading">
					<header class="panel-head"><h2 id="account-heading">Account</h2></header>
					<div class="row">
						<a class="btn" href="/password">Change password</a>
						<form class="inline-form" method="post" action="/logout">
							<button type="submit">Log out</button>
						</form>
					</div>
				</section>
			</main>
			<p id="autopilot-notice" class="toast" role="status"></p>
		</body>
	</html>
}

templ chatHead(h chatHeader) {
	<header id="chat-head" class="topbar">
		<a class="brand" href="/"><span class="brand-mark" aria-hidden="true">C</span>COS</a>
		<ul class="topbar-stats" aria-label="Status">
			<!-- TS-813 heartbeat state -->
			<li id="heartbeat-slot" class="stat">
				if h.Autopilot.Interval > 0 {
					<a href="/settings">Heartbeat { integer(h.Autopilot.Interval) } min · next { h.Autopilot.NextBeat() }</a>
				}
			</li>
			<li class="stat">{ integer(h.Running) } running</li>
			<li class="stat">{ integer(h.PRs) } PRs waiting</li>
		</ul>
		<nav class="topbar-nav" aria-label="Main">
			<a class="navlink" href="/">Chat</a>
			<a class="navlink hide-sm" href="/work">Work</a>
			<a id="inbox-slot" class="navlink" href="/inbox">Inbox <span class="badge badge-accent">{ integer(h.Inbox) }</span></a>
			<a class="navlink hide-sm" href="/tokens">Tokens</a>
			<a class="navlink" href="/settings">Settings</a>
		</nav>
	</header>
}

templ chatMessages(entries []ChatEntry) {
	<div id="messages" class="chat-thread" role="log" aria-live="polite">
		if len(entries) == 0 {
			<p class="msg system" id="m-empty">Ask COS anything: what's running, what needs you, or what to do next.</p>
		}
		for _, e := range entries {
			@chatEntry(e)
		}
	</div>
}

templ chatEntry(e ChatEntry) {
	<article id={ "m-" + e.ID } class={ "msg", e.Role }>
		switch e.Role {
			case "user":
				{ e.Text }
			case "system":
				<small>{ e.Text }</small>
			default:
				if len(e.Tools) > 0 {
					<details class="disclosure msg-tools">
						<summary>{ toolSummary(e.Tools) }</summary>
						<ol>
							for _, tool := range e.Tools {
								<li>{ tool }</li>
							}
						</ol>
					</details>
				}
				<div class="prose">@templ.Raw(renderMarkdown(e.Text))</div>
				if e.Streaming {
					<small class="msg-status" aria-busy="true">Working…</small>
				}
		}
	</article>
}
