package cos

templ workPage(h chatHeader, b workBoard) {
	<!DOCTYPE html>
	<html lang="en">
		@docHead("Work · COS")
		<body class="ts-app" data-init={ "@get('/work/events" + workQuery(b.Stage) + "', {retry: 'always', retryMaxCount: Infinity, retryMaxWait: 10000})" }>
			@chatHead(h, "work")
			<main class="page">
				@workPanel(b)
			</main>
		</body>
	</html>
}

// workPanel is the stage filter and the table; the events stream patches it by id.
templ workPanel(b workBoard) {
	<section id="work" class="panel" aria-labelledby="work-heading">
		<header class="panel-head"><h2 id="work-heading">Work <span class="badge badge-accent">{ integer(b.Total) }</span></h2></header>
		<div class="row" role="group" aria-label="Stage">
			for _, group := range b.Filters {
				<form class="segmented" method="get" action="/work">
					for _, f := range group {
						<button type="submit" name="stage" value={ f.Value } aria-pressed={ pressed(f.Current) }>{ f.Label } <span class="badge">{ integer(f.Count) }</span></button>
					}
				</form>
			}
		</div>
		if b.Total == 0 {
			<p class="empty">No work yet.</p>
		} else if len(b.Lines) == 0 {
			<p class="empty">Nothing in { b.Stage } right now.</p>
		} else {
			<div class="table-wrap">
				<table class="table table-compact">
					<thead>
						<tr>
							<th scope="col">Ticket</th>
							<th scope="col">Title</th>
							<th scope="col">Stage</th>
							<th scope="col">Blocker</th>
							<th scope="col">Threads</th>
							<th scope="col">Model</th>
							<th scope="col" class="num">Haiku</th>
							<th scope="col">PRs</th>
							<th scope="col">Deployed</th>
							<th scope="col" class="num">Age</th>
							<th scope="col">Last event</th>
						</tr>
					</thead>
					<tbody>
						for _, l := range b.Lines {
							<tr>
								<th scope="row" class="mono"><a class="row-link" href={ templ.SafeURL("/work/" + l.Row.Ticket) }>{ l.Row.Ticket }</a></th>
								<td>{ l.Row.Title }</td>
								<td><span class="stage" data-stage={ boardStageData(l.Row) }>{ l.Row.Stage }</span></td>
								<td>
									if l.Row.Blocker != "" {
										<span class="tag" data-tone="danger">{ l.Row.Blocker }</span>
									}
								</td>
								<td>{ threadsText(l.Row.Threads) }</td>
								<td>{ orDash(l.Usage.Model) }</td>
								<td class="num">{ haikuText(l.Usage) }</td>
								<td>
									for _, p := range l.Row.PRs {
										<span class="row">
											if p.URL != "" {
												<a href={ templ.URL(p.URL) }>#{ integer(p.Number) }</a>
											} else {
												<span>#{ integer(p.Number) }</span>
											}
											if p.Merged {
												<span class="tag" data-tone="ok">merged</span>
											}
										</span>
									}
								</td>
								<td>{ agoText(l.Row.Deployed) }</td>
								<td class="num">{ ageText(l.Row.Since) }</td>
								<td><span class="sub">{ orDash(clip(l.Row.LastEvent, workLastEvent)) }</span></td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}

templ workTicketPage(h chatHeader, t workTimeline) {
	<!DOCTYPE html>
	<html lang="en">
		@docHead(t.Ticket + " · Work · COS")
		<body class="ts-app">
			@chatHead(h, "work")
			<main class="page page-narrow">
				@workTicketPanel(t)
			</main>
		</body>
	</html>
}

// workTicketPanel is one ticket's row and its timeline, newest first.
templ workTicketPanel(t workTimeline) {
	<section id="work-ticket" class="panel" aria-labelledby="work-ticket-heading">
		<p class="meta"><a href="/work">← Work</a></p>
		if !t.Known {
			<p class="empty">No work for <span class="mono">{ t.Ticket }</span>. Check the ticket ID, or <a href="/work">open the board</a>.</p>
		} else {
			<header class="panel-head"><h2 id="work-ticket-heading"><span class="mono">{ t.Ticket }</span></h2></header>
			<article class="card stack">
				<header class="card-head">
					if t.OnBoard {
						<span class="stage" data-stage={ boardStageData(t.Row) }>{ t.Row.Stage }</span>
					} else {
						<span class="tag">Not on the board</span>
					}
					if t.Row.Blocker != "" {
						<span class="tag" data-tone="danger">{ t.Row.Blocker }</span>
					}
				</header>
				if t.Row.Title != "" && t.Row.Title != t.Ticket {
					<p>{ t.Row.Title }</p>
				}
				if t.OnBoard {
					<p class="meta">
						<span>Age { ageText(t.Row.Since) }</span>
						if !t.Row.Deployed.IsZero() {
							<span>Deployed { agoText(t.Row.Deployed) }</span>
						}
					</p>
				}
				if len(t.Row.PRs) > 0 {
					<p class="meta">
						for _, p := range t.Row.PRs {
							<span class="row">
								if p.URL != "" {
									<a href={ templ.URL(p.URL) }>{ p.Repo }#{ integer(p.Number) }</a>
								} else {
									<span>{ p.Repo }#{ integer(p.Number) }</span>
								}
								if p.Merged {
									<span class="tag" data-tone="ok">merged</span>
								}
							</span>
						}
					</p>
				}
				if len(t.Threads) > 0 {
					<ul class="list">
						for _, th := range t.Threads {
							<li class="row">
								<span>{ th.Host }</span>
								<span class="meta">{ orDash(modelLabel(th.Model)) }</span>
								<span class="meta mono">{ clip(th.ThreadID, 8) }</span>
							</li>
						}
					</ul>
				}
			</article>
			<header class="panel-head"><h2>Timeline <span class="badge">{ integer(len(t.Events)) }</span></h2></header>
			if len(t.Events) == 0 {
				<p class="empty">No events for this ticket yet.</p>
			} else {
				<ol class="list">
					for _, e := range t.Events {
						<li>
							<div class="row">
								<time title={ e.Exact }>{ e.Ago }</time>
								<span class="tag" data-tone={ e.Tone }>{ e.Kind }</span>
							</div>
							<span>{ e.Summary }</span>
							if e.PR != "" || e.Thread != "" {
								<span class="meta">
									if e.PR != "" {
										if e.PRURL != "" {
											<a href={ templ.URL(e.PRURL) }>{ e.PR }</a>
										} else {
											<span>{ e.PR }</span>
										}
									}
									if e.Thread != "" {
										<span class="mono">{ e.Thread }</span>
									}
								</span>
							}
						</li>
					}
				</ol>
			}
		}
	</section>
}
