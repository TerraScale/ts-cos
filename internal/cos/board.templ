package cos

templ workPage(h chatHeader, b workBoard) {
	<!DOCTYPE html>
	<html lang="en">
		@docHead("Work · COS")
		<body class="shell" data-init={ "@get('/work/events" + workQuery(b.Stage) + "', {retry: 'always', retryMaxCount: Infinity, retryMaxWait: 10000})" }>
			@chatHead(h)
			<main class="page">
				@workPanel(b)
			</main>
		</body>
	</html>
}

// workPanel is the stage filter and the table; the events stream patches it by id.
templ workPanel(b workBoard) {
	<section id="work" class="panel" aria-labelledby="work-heading">
		<header class="panel-head"><h2 id="work-heading">Work <span class="badge badge-accent">{ integer(b.Total) }</span></h2></header>
		<div class="row" role="group" aria-label="Stage">
			for _, group := range b.Filters {
				<form class="segmented" method="get" action="/work">
					for _, f := range group {
						<button type="submit" name="stage" value={ f.Value } aria-pressed={ pressed(f.Current) }>{ f.Label } <span class="badge">{ integer(f.Count) }</span></button>
					}
				</form>
			}
		</div>
		if b.Total == 0 {
			<p class="empty">No work yet.</p>
		} else if len(b.Lines) == 0 {
			<p class="empty">Nothing in { b.Stage } right now.</p>
		} else {
			<div class="table-wrap">
				<table class="table table-compact">
					<thead>
						<tr>
							<th scope="col">Ticket</th>
							<th scope="col">Title</th>
							<th scope="col">Stage</th>
							<th scope="col">Blocker</th>
							<th scope="col">Threads</th>
							<th scope="col" class="hide-sm">Model</th>
							<th scope="col" class="num hide-sm">Haiku</th>
							<th scope="col">PRs</th>
							<th scope="col" class="hide-sm">Deployed</th>
							<th scope="col" class="num">Age</th>
							<th scope="col" class="hide-sm">Last event</th>
						</tr>
					</thead>
					<tbody>
						for _, l := range b.Lines {
							<tr>
								<th scope="row" class="mono">{ l.Row.Ticket }</th>
								<td>{ l.Row.Title }</td>
								<td><span class="stage" data-stage={ boardStageData(l.Row) }>{ l.Row.Stage }</span></td>
								<td>
									if l.Row.Blocker != "" {
										<span class="tag" data-tone="danger">{ l.Row.Blocker }</span>
									}
								</td>
								<td>{ threadsText(l.Row.Threads) }</td>
								<td class="hide-sm">{ orDash(l.Usage.Model) }</td>
								<td class="num hide-sm">{ haikuText(l.Usage) }</td>
								<td>
									for _, p := range l.Row.PRs {
										<span class="row">
											if p.URL != "" {
												<a href={ templ.URL(p.URL) }>#{ integer(p.Number) }</a>
											} else {
												<span>#{ integer(p.Number) }</span>
											}
											if p.Merged {
												<span class="tag" data-tone="ok">merged</span>
											}
										</span>
									}
								</td>
								<td class="hide-sm">{ agoText(l.Row.Deployed) }</td>
								<td class="num">{ ageText(l.Row.Since) }</td>
								<td class="hide-sm"><span class="sub">{ orDash(clip(l.Row.LastEvent, workLastEvent)) }</span></td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}
