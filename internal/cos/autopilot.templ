package cos

templ autopilotPanel(a AutopilotState) {
	<section id="autopilot" class="panel" aria-labelledby="autopilot-heading">
		<header class="panel-head">
			<h2 id="autopilot-heading">Heartbeat</h2>
			if a.Leader == "" {
				<span class="tag" data-tone="warn">no leader yet</span>
			} else {
				<span class="tag" data-tone="ok">leader { a.Leader }</span>
			}
		</header>
		if a.Error != "" {
			<p role="alert" class="alert" data-tone="danger">{ a.Error }</p>
		}
		<div class="stack">
			<p class="meta">Every { integer(a.Interval) } minutes · last { orNone(a.LastBeat) } · next { a.NextBeat() }</p>
			<div class="row settings-controls">
				<div class="segmented" role="group" aria-label="Heartbeat interval">
					for _, m := range autopilotPresets {
						<button type="button" aria-pressed={ boolText(m == a.Interval) } data-on:click={ "@post('/autopilot/interval/" + integer(m) + "')" }>{ integer(m) } min</button>
					}
				</div>
				<button type="button" data-on:click="@post('/autopilot/run')">Run now</button>
			</div>
			<details class="disclosure">
				<summary>Recent actions ({ integer(len(a.Log)) })</summary>
				<div class="table-wrap" tabindex="0" role="region" aria-label="Autopilot actions">
					<table class="table">
						<thead><tr><th scope="col">Time</th><th scope="col">Kind</th><th scope="col">Target</th><th scope="col">Action</th><th scope="col">Reason</th></tr></thead>
						<tbody>
							if len(a.Log) == 0 {
								<tr><td colspan="5">No actions yet.</td></tr>
							}
							for _, e := range a.Log {
								<tr><td>{ e.At }<span class="sub">{ e.Host }</span></td><td>{ e.Kind }</td><td>{ e.Target }</td><td>{ e.Action }</td><td>{ e.Reason }</td></tr>
							}
						</tbody>
					</table>
				</div>
			</details>
		</div>
	</section>
}
