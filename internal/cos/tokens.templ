package cos

templ tokensPage(h chatHeader, d tokensPageData) {
	<!DOCTYPE html>
	<html lang="en">
		@docHead("Tokens · COS")
		<body class="shell" data-init={ "@get('/tokens/events?w=" + d.Window + "', {retry: 'always', retryMaxCount: Infinity, retryMaxWait: 10000})" }>
			@chatHead(h)
			<main class="page">
				@tokens(d)
			</main>
		</body>
	</html>
}

// tokens is the live region: window switcher, KPIs, savings and tables.
templ tokens(d tokensPageData) {
	<section id="tokens" class="stack" aria-labelledby="tokens-heading">
		<section class="panel" aria-labelledby="tokens-heading">
			<header class="panel-head">
				<h2 id="tokens-heading">Tokens</h2>
				<form class="segmented" method="get" action="/tokens" aria-label="Window">
					<button type="submit" name="w" value="today" aria-pressed={ boolText(d.Window == "today") }>Today</button>
					<button type="submit" name="w" value="7d" aria-pressed={ boolText(d.Window == "7d") }>7 days</button>
					<button type="submit" name="w" value="30d" aria-pressed={ boolText(d.Window == "30d") }>30 days</button>
				</form>
			</header>
			<div class="kpis">
				@tokenKPI("Cost", usd(d.Total.Cost), "USD", "")
				@tokenKPI("Tokens", humanTokens(d.Total.Input+d.Total.CacheWrite+d.Total.Output), "in + cache write + out", "")
				@tokenKPI("Haiku share", integer(d.Total.HaikuShare)+"%", "of output", shareTone(d.Total))
				@tokenKPI("Opus advisor", usd(d.Total.AdvisorCost), "USD", "")
				@tokenKPI("Haiku workers", usd(d.Total.WorkerCost), "USD", "")
				@tokenKPI("Peak Haiku parallel", integer(d.Parallel), "workers at once", "")
				@tokenKPI("Saved", usd(d.Workers+d.Rules), "USD estimated", "")
			</div>
		</section>
		@tokenSavingsCard(d)
		if !d.Empty {
			@tokenThreadTable(d.Threads)
			@tokenTotalsTable("By ticket", "Ticket", d.Tickets)
			@tokenTotalsTable("By model", "Model", d.Models)
			if d.Window != "today" {
				@tokenTotalsTable("By day", "Day", d.Days)
			}
		}
	</section>
}

templ tokenKPI(label, value, unit, tone string) {
	<div class="kpi" data-tone={ tone }>
		<span class="kpi-label">{ label }</span>
		<span class="kpi-value">{ value }</span>
		<span class="kpi-unit">{ unit }</span>
	</div>
}

templ tokenSavingsCard(d tokensPageData) {
	<section class="card" aria-labelledby="savings-heading">
		<header class="card-head"><h3 id="savings-heading">Savings</h3></header>
		<ul class="list">
			<li>
				<span class="row"><span>Haiku workers instead of Opus</span><span>{ money(d.Workers) }</span></span>
				<span class="sub">Same tokens at Opus 5.5 list price, minus what Haiku cost.</span>
			</li>
			<li>
				<span class="row"><span>Zero-token rule actions (estimated)</span><span>{ money(d.Rules) }</span></span>
				<span class="sub">{ integer(d.RuleActions) } rule actions × { money(d.AdvisorAvg) } average Opus advisor message.</span>
			</li>
		</ul>
	</section>
}

templ tokenThreadTable(threads []UsageTotal) {
	<section class="card" aria-labelledby="threads-heading">
		<header class="card-head"><h3 id="threads-heading">By thread</h3></header>
		<div class="table-wrap">
			<table class="table table-compact">
				<caption class="sr-only">Usage by thread</caption>
				<thead>
					<tr>
						<th scope="col">Thread</th>
						<th scope="col" class="num">Output, Opus · Haiku</th>
						<th scope="col" class="num">Haiku workers</th>
						<th scope="col" class="num">Most in parallel</th>
						<th scope="col" class="num">Haiku share</th>
						<th scope="col" class="num">Cost</th>
					</tr>
				</thead>
				<tbody>
					for _, t := range threads {
						<tr>
							<td>
								if t.Ticket != "" {
									<a href={ templ.SafeURL("/work/" + t.Ticket) }>{ t.Label }</a>
								} else {
									{ t.Label }
								}
							</td>
							<td class="num">{ humanTokens(t.AdvisorOutput) } · { humanTokens(t.WorkerOutput) }</td>
							<td class="num">{ integer(t.Workers) }</td>
							<td class="num">{ integer(t.Parallel) }</td>
							<td class="num">{ integer(t.HaikuShare) }%</td>
							<td class="num">{ money(t.Cost) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
}

templ tokenTotalsTable(title, keyHeader string, rows []UsageTotal) {
	<section class="card" aria-labelledby={ "tokens-" + keyHeader }>
		<header class="card-head"><h3 id={ "tokens-" + keyHeader }>{ title }</h3></header>
		<div class="table-wrap">
			<table class="table table-compact">
				<caption class="sr-only">{ title }</caption>
				<thead>
					<tr>
						<th scope="col">{ keyHeader }</th>
						<th scope="col" class="num">Input</th>
						<th scope="col" class="num">Output</th>
						<th scope="col" class="num">Cache write</th>
						<th scope="col" class="num">Cache read</th>
						<th scope="col" class="num">Cost</th>
					</tr>
				</thead>
				<tbody>
					for _, t := range rows {
						<tr>
							<td>{ t.Label }</td>
							<td class="num">{ humanTokens(t.Input) }</td>
							<td class="num">{ humanTokens(t.Output) }</td>
							<td class="num">{ humanTokens(t.CacheWrite) }</td>
							<td class="num">{ humanTokens(t.CacheRead) }</td>
							<td class="num">{ money(t.Cost) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
}
