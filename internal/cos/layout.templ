package cos

// docHead is every page's head: the one embedded stylesheet and Datastar.
templ docHead(title string) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"/>
		<meta name="color-scheme" content="light dark"/>
		<title>{ title }</title>
		@pwaHead()
		<link rel="stylesheet" href={ templ.SafeURL(cssPath) }/>
		<link rel="icon" href="/static/icon.svg" type="image/svg+xml"/>
		<link rel="icon" href="/static/favicon-32.png" sizes="32x32" type="image/png"/>
		<link rel="apple-touch-icon" href="/static/apple-touch-icon.png"/>
		<meta name="theme-color" content="#f7f8fa" media="(prefers-color-scheme: light)"/>
		<meta name="theme-color" content="#0d0e11" media="(prefers-color-scheme: dark)"/>
		<script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@v1.0.4/bundles/datastar.js"></script>
	</head>
}
