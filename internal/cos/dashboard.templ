package cos

templ page(v Dashboard) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>COS · TerraScale</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2.1.1/css/pico.classless.min.css"/>
			<script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@v1.0.4/bundles/datastar.js"></script>
			<style>main{max-width:1440px} .table-scroll{overflow-x:auto} td{vertical-align:top} small{display:block} mark{white-space:nowrap}</style>
		</head>
		<body data-init="@get('/events')">
			@dashboard(v)
		</body>
	</html>
}

templ dashboard(v Dashboard) {
	<main id="dashboard">
		<header>
			<h1>COS · TerraScale</h1>
			<p>Live refresh: { v.Live.At } · Story updates on change</p>
		</header>
		for _, key := range sortedKeysAny(v.Live.Errors) {
			<p role="alert"><strong>{ key } refresh failed:</strong> { v.Live.Errors[key] } · Previous data stays visible.</p>
		}
		<section aria-labelledby="direction-heading">
			<h2 id="direction-heading">Direction</h2>
			if v.Story.Direction == "" {
				<p>No direction set.</p>
			} else {
				<p>{ v.Story.Direction }</p>
			}
			<p>{ integer(v.Running) } running threads · { integer(len(v.Live.PRs)) } open PRs · { integer(v.Ready) } ready · { integer(v.Failing) } CI failing · { integer(len(v.Tasks)) } open tasks</p>
		</section>
		<section aria-labelledby="needs-heading">
			<h2 id="needs-heading">Needs you</h2>
			if len(notesOf(v.Story.Notes, "need")) > 0 || len(v.Live.Asks) == 0 {
				@noteList(v.Story.Notes, "need")
			}
			for _, a := range v.Live.Asks {
				<article>
					<header>{ a.Host } · { a.Title }</header>
					if a.Stale {
						<small>Host unavailable · question from the last successful refresh</small>
					}
					if a.Error != "" {
						<p role="alert">{ a.Error }</p>
					} else if a.Kind == "request" {
						<p>Pending { a.RequestKind } request</p>
						<pre>{ jsonText(a.Payload) }</pre>
					} else {
						<p><strong>{ a.Question }</strong></p>
						if len(a.Options) > 0 {
							<ol>
								for _, option := range a.Options {
									<li>{ option }</li>
								}
							</ol>
						}
						<p>{ a.Why }</p>
					}
				</article>
			}
		</section>
		<section aria-labelledby="decisions-heading">
			<h2 id="decisions-heading">Decided for you</h2>
			@noteList(v.Story.Notes, "decide")
		</section>
		<section aria-labelledby="priorities-heading">
			<h2 id="priorities-heading">Priorities</h2>
			<div class="table-scroll" tabindex="0" role="region" aria-label="Open priorities">
				<table>
					<thead><tr><th scope="col">Ticket</th><th scope="col">Priority</th><th scope="col">Repo · outcome</th><th scope="col">Status</th><th scope="col">Model · why</th><th scope="col">Why this task</th><th scope="col">PR</th><th scope="col">Next</th></tr></thead>
					<tbody>
						if len(v.Tasks) == 0 {
							<tr><td colspan="8">Nothing open.</td></tr>
						}
						for _, task := range v.Tasks {
							<tr>
								<th scope="row">{ task.Ticket }</th>
								<td>
									if task.Priority == "FULL SEND" {
										<mark>{ task.Priority }</mark>
									} else {
										{ task.Priority }
									}
								</td>
								<td>{ task.Repo }<small>{ task.Outcome }</small></td>
								<td>{ task.Status }<small>{ task.Host }</small>
									if task.Stale {
										<small>Host unavailable · last known state</small>
									}
								</td>
								<td>{ task.Model }<small>{ task.ModelWhy }</small></td>
								<td>{ task.Why }</td>
								<td>
									if task.PR != "" {
										<a href={ templ.URL(task.PR) }>PR</a>
									}
								</td>
								<td>{ task.Next }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</section>
		<section aria-labelledby="missing-heading"><h2 id="missing-heading">What we're missing</h2>@noteList(v.Story.Notes, "missing")</section>
		<section aria-labelledby="suggestions-heading"><h2 id="suggestions-heading">Suggestions</h2>@noteList(v.Story.Notes, "suggest")</section>
		<section aria-labelledby="prs-heading">
			<h2 id="prs-heading">Open PRs</h2>
			for _, pr := range v.Live.PRs {
				<article>
					<header><a href={ templ.URL(pr.URL) }>{ pr.Repo }#{ integer(pr.Number) }</a> · { pr.Title }</header>
					<p>CI: { pr.CI } · Review: { reviewLabel(pr) } · Merge: { mergeLabel(pr) }</p>
					if len(pr.Failing) > 0 {
						<p>Failing: { join(pr.Failing) }</p>
					}
					if len(pr.Pending) > 0 {
						<p>Pending: { join(pr.Pending) }</p>
					}
				</article>
			}
			if len(v.Live.PRs) == 0 {
				<p>No open PRs.</p>
			}
		</section>
		<section aria-labelledby="fleet-heading">
			<h2 id="fleet-heading">Threads by host</h2>
			for _, host := range v.Live.Fleet {
				<article>
					<header><strong>{ host.Host }</strong> · { integer(host.Active) } active</header>
					if host.Error != "" {
						<p role="alert">{ host.Error }</p>
					}
					if host.Error == "" || len(host.Threads) > 0 {
						if host.Stale {
							<p>Threads from the last successful refresh.</p>
						}
						<ul>
							for _, thread := range host.Threads {
								<li><strong>{ thread.Status }</strong> · { thread.Title }<small>{ thread.Model } · { thread.Project }</small>
									if thread.NeedsInput {
										<strong>Needs input</strong>
									}
									if thread.LastError != "" {
										<small>{ thread.LastError }</small>
									}
								</li>
							}
						</ul>
						if len(host.Threads) == 0 {
							<p>No open threads.</p>
						}
					}
				</article>
			}
		</section>
	</main>
}

templ noteList(notes []Note, kind string) {
	if len(notesOf(notes, kind)) == 0 {
		<p>Nothing.</p>
	} else {
		<ul>
			for _, note := range notesOf(notes, kind) {
				<li>{ note.Text }</li>
			}
		</ul>
	}
}
