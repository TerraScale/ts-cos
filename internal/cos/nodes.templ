package cos

// nodesPage is the overview: one live card per node, repatched by nodesEvents.
templ nodesPage(cluster ClusterView, cards []NodeCard) {
	<!DOCTYPE html>
	<html lang="en">
		@docHead("Nodes · COS")
		<body class="shell" data-init="@get('/nodes/events', {retry: 'always', retryMaxCount: Infinity, retryMaxWait: 10000})">
			@nodesTopbar()
			<main class="page">
				<section class="panel" aria-labelledby="nodes-heading">
					<header class="panel-head"><h1 id="nodes-heading">Nodes</h1></header>
					@nodesGrid(cluster, cards)
				</section>
			</main>
		</body>
	</html>
}

templ nodesTopbar() {
	<header class="topbar">
		<a class="brand" href="/"><span class="brand-mark" aria-hidden="true">C</span>COS</a>
		<nav class="topbar-nav" aria-label="Main">
			<a class="navlink" href="/">Chat</a>
			<a class="navlink" href="/inbox">Inbox</a>
			<a class="navlink" href="/nodes" aria-current="page">Nodes</a>
			<a class="navlink" href="/settings">Settings</a>
		</nav>
	</header>
}

// nodesGrid is the patch target: every card redraws when /nodes/events sends it.
// Desktop is 2×2; the NATS cluster tile takes the last cell.
templ nodesGrid(cluster ClusterView, cards []NodeCard) {
	<div id="nodes-grid" class="grid-2">
		if len(cards) == 0 {
			<p class="empty">No nodes have reported yet.</p>
		}
		for _, c := range cards {
			<div>
				@nodeCard(c)
			</div>
		}
		<div>
			@nodesCluster(cluster, cards)
		</div>
	</div>
}

// nodeCard is one node at a glance: state, CPU trend, three meters and one muted line. Details live on /nodes/<host>.
templ nodeCard(c NodeCard) {
	<section class="card card-compact" id={ c.Host }>
		<div class="row">
			<span class="dot" data-state={ c.State }></span>
			<strong><a href={ "/nodes/" + c.Host }>{ c.Host }</a></strong>
			<span class="muted">{ nodeMeta(c) }</span>
		</div>
		@sparkline(c.CPU, 1, 100)
		if c.known() {
			@meterRow("CPU", c.Sample.CPU)
			@meterRow("Memory", c.Sample.Mem.UsedPercent())
			if d := c.fullestDisk(); d.Total > 0 {
				@meterRow("Disk "+d.Mount, d.UsedPercent())
			}
		}
		if s := c.summary(); s != "" {
			<p class="muted">{ s }</p>
		}
	</section>
}

// sparkline is a KPI's trend, scaled to ymax (0 means the series max); without samples it draws nothing.
templ sparkline(values []float64, series int, ymax float64) {
	if len(values) > 0 {
		<svg class="spark" data-series={ integer(series) } viewBox="0 0 100 24" preserveAspectRatio="none" aria-hidden="true">
			<path class="spark-area" d={ sparkArea(values, ymax) }></path>
			<path class="spark-line" d={ sparkLine(values, ymax) }></path>
		</svg>
	}
}

templ meterRow(label string, used float64) {
	<label class="meter-row">
		<span class="meter-label">{ label }</span>
		<meter class="meter" min="0" max="100" low="70" high="85" optimum="0" value={ formatFixed(used, 1) }></meter>
		<span class="meter-value">{ formatPercent(used) }</span>
	</label>
}
