package cos

templ inboxPage(h chatHeader, v Dashboard) {
	<!DOCTYPE html>
	<html lang="en">
		@pageHead()
		<body data-init="@get('/inbox/events', {retry: 'always', retryMaxCount: Infinity, retryMaxWait: 10000})">
			@chatHead(h)
			<main>
				@inbox(v)
			</main>
		</body>
	</html>
}

// The Inbox mirrors T3 Code's: a list of what COS needs, each opening to its
// context with answer controls. Open items keep their state across live patches.
templ inbox(v Dashboard) {
	<section id="inbox" aria-labelledby="inbox-heading">
		<h2 id="inbox-heading">Inbox <mark>{ integer(len(v.Inbox)) }</mark></h2>
		if len(v.Inbox) == 0 {
			<p>Nothing needs you. COS keeps working.</p>
		}
		for _, item := range v.Inbox {
			<details id={ "inbox-" + item.ID } name="inbox" data-preserve-attr="open">
				<summary>
					<strong>{ inboxKindLabel(item) }</strong> · { item.Title }
					<small>
						{ age(item.Created) } ago
						if item.Blocks != "" {
							· blocks { item.Blocks }
						}
						if item.Ticket != "" {
							· { item.Ticket }
						}
					</small>
				</summary>
				<article>
					if item.Context != "" {
						<p class="inbox-text">{ item.Context }</p>
					}
					<p>
						if url := ticketURL(v, item.Ticket); url != "" {
							<a href={ templ.URL(url) }>{ item.Ticket }</a> ·
						}
						for _, link := range item.Links {
							<a href={ templ.URL(link) }>{ link }</a> ·
						}
						<small>From { item.Source }
							if item.Host != "" {
								· { item.Host } worker thread
							}
						</small>
					</p>
					if item.Kind != "fyi" {
						<form method="post" action={ templ.SafeURL("/inbox/" + item.ID + "/answer") } data-on:submit={ "@post('/inbox/" + item.ID + "/answer', {contentType: 'form'})" }>
							if len(item.Options) > 0 {
								<div class="inbox-options" role="group" aria-label="Options">
									for i, option := range item.Options {
										<button type="submit" name="option" value={ option }>
											{ option }
											if i == 0 && item.Kind == "question" {
												(Recommended)
											}
										</button>
									}
								</div>
							}
							<label>
								{ inboxTextLabel(item) }
								<textarea name="text" rows="2" maxlength="3000"></textarea>
							</label>
							<button type="submit">Send</button>
						</form>
					}
					if item.Kind == "decision" || item.Kind == "blocker" || item.Kind == "fyi" {
						<form method="post" action={ templ.SafeURL("/inbox/" + item.ID + "/dismiss") } data-on:submit={ "@post('/inbox/" + item.ID + "/dismiss', {contentType: 'form'})" }>
							<button type="submit">
								if item.Kind == "decision" {
									Keep this decision
								} else {
									Got it
								}
							</button>
						</form>
					}
				</article>
			</details>
		}
		if len(v.History) > 0 {
			<details>
				<summary>History ({ integer(len(v.History)) })</summary>
				<ul>
					for _, item := range v.History {
						<li>
							<strong>{ item.Status }</strong> · { item.Title }
							if item.Answer != nil {
								<small class="inbox-text">Answer: { answerText(item.Answer) }</small>
							}
							if item.Note != "" {
								<small>{ item.Note }</small>
							}
							<small>
								{ age(item.Closed) } ago on { item.ClosedOn }
								if item.ForwardError != "" {
									· forward to worker failed, retrying: { item.ForwardError }
								}
							</small>
						</li>
					}
				</ul>
			</details>
		}
	</section>
}
